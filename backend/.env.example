# ---- Server ----
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
# Number of reverse proxies in front of the server (0 locally, 1 on Render/Railway/Fly)
TRUST_PROXY=0

# ---- Database (plain PostgreSQL 16 with pgvector) ----
DATABASE_URL=postgres://parkgrid:parkgrid@localhost:54329/parkgrid
DATABASE_SSL=false
DB_POOL_MAX=10

# ---- Auth ----
# openssl rand -base64 48   (min 32 chars, server refuses to boot otherwise)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-0000
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=30

# ---- Payments: mock (dev/tests) or razorpay (test-mode keys from the Razorpay dashboard) ----
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- AI / RAG (optional: without a key the assistant falls back to retrieval-only answers) ----
OPENAI_API_KEY=
# Free assistant answers via Groq (https://console.groq.com): set GROQ_API_KEY, takes priority over OpenAI for chat
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RAG_TOP_K=5
RAG_MIN_SCORE=0.25

# ---- Mail (dev: Mailpit from docker-compose) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ParkGrid <no-reply@parkgrid.local>
APP_URL=http://localhost:8080

# ---- Jobs ----
CRON_SECRET=change-me-cron-secret-0000
ENABLE_JOBS=true

# ---- Seeds (never hard-coded) ----
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ---- Optional: Redis adapter for multi-instance Socket.IO ----
REDIS_URL=

# ---- Free-tier demo hosting (no shell): create layout/KB/demo logins on first boot ----
BOOTSTRAP_ON_BOOT=false
DEMO_SEED=false
DEMO_PASSWORD=
